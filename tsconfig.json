{
  "compilerOptions": {
    "target": "ES2017",              // Compile to ES2017 — safe for most modern browsers and Node versions
    "lib": ["dom", "dom.iterable", "esnext"], // Built-in types TS knows about: dom = browser APIs, esnext = latest JS features
    "allowJs": true,                 // Allows .js files in your project alongside .ts files
    "skipLibCheck": true,            // Skips type checking node_modules .d.ts files — speeds up builds
    "strict": true,                  // Enables all strict type checks at once (recommended always)
    "noEmit": true,                  // Don't output any .js files — Next.js handles compilation itself
    "esModuleInterop": true,         // Lets you write `import fs from 'fs'` instead of `import * as fs from 'fs'`
    "module": "esnext",              // Use modern ES module syntax (import/export)
    "moduleResolution": "bundler",   // How TS finds imported files — 'bundler' is optimized for Vite/Next.js/esbuild
    "resolveJsonModule": true,       // Lets you import .json files directly: `import data from './data.json'`
    "isolatedModules": true,         // Each file must work on its own — required by Next.js/Babel/esbuild
    "jsx": "react-jsx",              // Enables JSX and uses React 17+ automatic transform (no need to import React)
    "incremental": true,             // Caches previous compilation so rebuilds are faster
    "plugins": [
      {
        "name": "next"               // Enables the Next.js TypeScript plugin for extra editor hints and checks
      }
    ],
    "paths": {
      "@/*": ["./*"]                 // Path alias — lets you write `import X from '@/components/X'` instead of `../../components/X`
    }
  },
  "include": [
    "next-env.d.ts",                 // Next.js auto-generated type definitions
    "globals.d.ts",                  // This is going to be include for typescript to ignore globals.css
    "**/*.ts",                       // Include all TypeScript files
    "**/*.tsx",                      // Include all TypeScript + JSX files (React components)
    ".next/types/**/*.ts",           // Include types generated by Next.js build
    ".next/dev/types/**/*.ts",       // Include types generated during Next.js dev mode
    "**/*.mts"                       // Include ES module TypeScript files (.mts extension)
  ],
  "exclude": ["node_modules"]        // Don't type-check anything inside node_modules
}